#!/bin/sh
# `pi` inside the gondo-pi VM: the real pi with the gondo-pi extension. When pi exits
# with 75 (new access was granted: credential route, directory), the VM is recreated
# with it and pi resumes the same conversation (--continue). Your shell is untouched.
real=$(PATH=$(printf '%s' "$PATH" | sed 's#/gondo-pi/bin:##g') command -v pi)
[ -n "$real" ] || { echo "gondo-pi: pi is not installed in this VM image" >&2; exit 127; }
# pi's packages (extensions) are installed for Linux in the background on the first
# start of a new package set; wait for that so pi doesn't load macOS-only binaries
if [ ! -f /run/gondo-pi-npm.done ]; then
  printf 'gondo-pi: installing pi packages for Linux (first run only)…' >&2
  i=0; while [ ! -f /run/gondo-pi-npm.done ] && [ $i -lt 600 ]; do sleep 1; i=$((i+1)); printf '.' >&2; done; echo >&2
fi
case "$(cat /run/gondo-pi-npm.done 2>/dev/null)" in failed*) echo "gondo-pi: $(cat /run/gondo-pi-npm.done); some pi extensions may not load" >&2 ;; esac
first=1
while :; do
  if [ "$first" = 1 ]; then
    "$real" -e /gondo-pi/pi-extension "$@"
  else
    "$real" -e /gondo-pi/pi-extension --continue
  fi
  rc=$?
  [ "$rc" = 75 ] || exit "$rc"
  first=0
  echo "gondo-pi: applying the new access (restarting the VM, same conversation)…" >&2
  python3 /gondo-pi/bin/gondo-pi apply >/dev/null 2>&1 || true
  # the VM restart ends this shell; if we're still here (nothing to apply), just resume
done
