# gondo-pi devbox (Arch Linux) - the rootfs of the x86_64 microVM.
# Built rootless with podman, then turned into a Gondolin image (vm/image-x86_64-arch.json).
# Everything here is public software: no secrets, no host config.
FROM docker.io/library/archlinux:base-devel
ARG PARALLEL=5
ARG PI_VERSION=1.6.0

RUN sed -i "s/^#\?ParallelDownloads.*/ParallelDownloads = ${PARALLEL}/" /etc/pacman.conf \
 && pacman -Syu --noconfirm --needed \
      fish git git-lfs git-delta openssh zellij neovim vim tmux \
      zig clang cmake ninja python uv mise just direnv \
      ripgrep fd fzf bat eza zoxide jq go-yq tree wget unzip less man-db which \
      btop htop procps-ng e2fsprogs tree-sitter-cli luarocks lua51 wl-clipboard \
      github-cli aws-cli-v2 terraform nodejs npm go rust \
 && pacman -Scc --noconfirm \
 && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

# pi, pinned to the host's version at build time (gondo-pi passes PI_VERSION)
RUN npm install -g --no-audit --no-fund "@earendil-works/pi-coding-agent@${PI_VERSION}" && npm cache clean --force

# fish as the login shell; home is /home/pi (the VM runs commands as root)
RUN sed -i 's#^root:x:0:0:root:/root:.*#root:x:0:0:root:/home/pi:/usr/bin/fish#' /etc/passwd \
 && mkdir -p /home/pi && echo gondo-pi-vm > /etc/hostname \
 # rootless image builds extract this as your user: dirs/files we can't read or write (0555
 # cadir, 0000 /run/systemd/dissect-root, 4750 dbus helper) break the build there. /run is
 # runtime state anyway; inside the VM everything runs as root, so the rest changes nothing.
 && rm -rf /run/* \
 && find / -xdev \( -path /proc -o -path /sys -o -path /dev \) -prune -o -type d ! -perm -u=rwx -exec chmod u+rwx {} + \
 && find / -xdev \( -path /proc -o -path /sys -o -path /dev \) -prune -o -type f ! -perm -u=r -exec chmod u+r {} +
