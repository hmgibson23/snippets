#!/usr/bin/env python3
"""nono-pi: run pi so that it never holds a credential, and just works.

  pis / nono-pi [pi args]      start or reattach the session for this project
                               (zellij `pi-<project>`: pi + status line; prompts float)
  nono-pi --aws a,b | none     pre-approve AWS accounts (others ask on first use)
  nono-pi --configure          re-pick the remembered choices for this project
  nono-pi --vm / --no-vm       run the agent in a Gondolin microVM (remembered)
  nono-pi --print-profile      show the generated nono profile
  nono-pi setup                one-time: nono-pi keychain, ssh key passphrase, migration
  nono-pi-key ls|set|rm|status|grants|revoke|aws-refresh

See DESIGN.md for the model: the trusted side (this machine / the devbox)
holds every credential; pi and its tools (nono sandbox or microVM) get only
placeholders and brokers that ask the user, once per scoped time window.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from nonopi.launcher import main  # noqa: E402

if __name__ == "__main__":
    if sys.argv[1:2] == ["--help-nono-pi"]:
        print(__doc__)
        sys.exit(0)
    main(sys.argv[1:])
