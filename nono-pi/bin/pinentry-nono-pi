#!/usr/bin/env python3
"""pinentry-compatible prompter for saml2aws (trusted side).

saml2aws --prompter pinentry-nono-pi runs us with `--ttyname /dev/tty` and
speaks a subset of the Assuan protocol on stdin/stdout:
  SETPROMPT <text>\nGETPIN\n   ->  D <pin>\nOK\n
We forward the prompt to the nono-pi supervisor (ctl.sock), which shows it
in a trusted prompt (zellij floating pane / dialog).
"""
import json
import os
import socket
import sys


def ask(prompt: str) -> str | None:
    path = os.environ.get("PI_NONO_CTL")
    if not path:
        return None
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(330)
    s.connect(path)
    s.sendall((json.dumps({"op": "pin", "prompt": prompt}) + "\n").encode())
    r = json.loads(s.makefile("rb").readline() or b"{}")
    return r.get("value") if r.get("ok") else None


def main() -> None:
    out = sys.stdout
    out.write("OK Pleased to meet you\n")
    out.flush()
    prompt = "Okta verification code"
    for line in sys.stdin:
        cmd, _, arg = line.rstrip("\n").partition(" ")
        cmd = cmd.upper()
        if cmd in ("SETPROMPT", "SETDESC", "SETTITLE"):
            if arg:
                prompt = arg.replace("%0A", "\n")
            out.write("OK\n")
        elif cmd == "GETPIN":
            pin = ask(prompt)
            if pin is None:
                out.write("ERR 83886179 Operation cancelled\n")
            else:
                out.write(f"D {pin}\nOK\n")
        elif cmd == "BYE":
            out.write("OK closing connection\n")
            out.flush()
            return
        else:
            out.write("OK\n")
        out.flush()


if __name__ == "__main__":
    main()
