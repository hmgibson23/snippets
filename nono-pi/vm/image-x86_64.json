{
  "arch": "x86_64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.7",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "rng-tools",
      "bash",
      "ca-certificates",
      "ca-certificates-bundle",
      "curl",
      "e2fsprogs",
      "e2fsprogs-extra",
      "nodejs",
      "npm",
      "uv",
      "python3",
      "py3-pip",
      "git",
      "openssh-client",
      "github-cli",
      "aws-cli",
      "ripgrep",
      "fd",
      "jq",
      "less",
      "make",
      "coreutils",
      "findutils",
      "grep",
      "sed",
      "tar",
      "gzip",
      "xz",
      "unzip",
      "file",
      "procps",
      "build-base",
      "go",
      "rust",
      "cargo",
      "fish",
      "neovim",
      "vim",
      "tmux",
      "htop",
      "fzf",
      "zoxide",
      "bat",
      "eza",
      "tree",
      "wget",
      "man-pages",
      "ncurses-terminfo",
      "openssh-keygen",
      "util-linux",
      "shadow",
      "tzdata",
      "git-lfs",
      "delta"
    ],
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "rootfs": {
    "label": "gondolin-root",
    "size": "8G"
  },
  "postBuild": {
    "commands": [
      "set -e; cd /tmp && curl -fsSLo tf.zip https://releases.hashicorp.com/terraform/1.17.2/terraform_1.17.2_linux_amd64.zip && echo 'e6f16b2f0b137ee5729caa8c4e79a3bae4ee261acd198a1fcfa8584a6296605b  tf.zip' | sha256sum -c - && unzip -o tf.zip terraform -d /usr/local/bin && rm tf.zip",
      "set -e; npm install -g --no-audit --no-fund @earendil-works/pi-coding-agent@1.6.0",
      "set -e; adduser -D -u 501 -s /usr/bin/fish pi || true; sed -i 's#^root:x:0:0:root:/root:.*#root:x:0:0:root:/home/pi:/usr/bin/fish#' /etc/passwd"
    ]
  }
}
